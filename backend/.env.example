# ========================================================================
# WOW THAILAND — Node.js & MySQL Environment Configuration Template
# ========================================================================
# Instructions:
# 1. Copy this file to '.env' in this directory.
# 2. Configure your local MySQL credentials.
# 3. Generate a strong, cryptographically secure JWT secret using the command:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. NEVER commit the actual '.env' file or share credentials.
# ========================================================================

# Application Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL 8.0 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_local_mysql_password_here
DB_NAME=wow_thailand

# Security & Authentication
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" to generate
JWT_SECRET=generate_and_paste_a_random_64_char_hex_secret_here
JWT_EXPIRES_IN=7d

# Base Currency & Localisation
BASE_CURRENCY=THB
SUPPORTED_CURRENCIES=THB,INR,USD

# Controlled Wallet Business Rules
MAX_NEGATIVE_BOOKINGS=2
DEFAULT_PLATFORM_FEE_PERCENTAGE=10.0

# Local development only: accept shared demo passwords (admin@123, etc.) for any account.
# Must be absent or false in production.
ALLOW_DEMO_PASSWORDS=false

# Public address of the website, used in tracking links sent to customers
PUBLIC_APP_URL=http://localhost:5173

# Customer ride messages (SMS, WhatsApp, email) when a cab is booked and when a driver is assigned.
# Master switch: nothing is sent unless this is true. Keep it false on any server you run
# the test suites against, or test bookings will message their (fake) phone numbers.
RIDE_NOTIFICATIONS_ENABLED=false

# SMS & WhatsApp go through Twilio. Leave blank to skip a channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender: a Twilio phone number (e.g. +1...) OR a Messaging Service SID (MG...)
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# WhatsApp sender, e.g. whatsapp:+14155238886 (Twilio sandbox) or your approved WhatsApp number
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp templates (Content SIDs, HX...). Needed in production to message a customer first.
#   Booked:          {{1}} first name, {{2}} booking ref, {{3}} pickup time, {{4}} pickup address, {{5}} start code, {{6}} tracking link
#   Driver assigned: {{1}} driver name, {{2}} driver phone, {{3}} car, {{4}} plate, {{5}} pickup time, {{6}} tracking link
TWILIO_WHATSAPP_TEMPLATE_BOOKED=
TWILIO_WHATSAPP_TEMPLATE_DRIVER_ASSIGNED=
