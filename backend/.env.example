# ========================================================================
# WOW THAILAND — Node.js & MySQL Environment Configuration Template
# ========================================================================
# Instructions:
# 1. Copy this file to '.env' in this directory.
# 2. Configure your local MySQL credentials.
# 3. Generate a strong, cryptographically secure JWT secret using the command:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. NEVER commit the actual '.env' file or share credentials.
# ========================================================================

# Application Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL 8.0 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_local_mysql_password_here
DB_NAME=wow_thailand

# Security & Authentication
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" to generate
JWT_SECRET=generate_and_paste_a_random_64_char_hex_secret_here
JWT_EXPIRES_IN=7d

# Base Currency & Localisation
BASE_CURRENCY=THB
SUPPORTED_CURRENCIES=THB,INR,USD

# Controlled Wallet Business Rules
MAX_NEGATIVE_BOOKINGS=2
DEFAULT_PLATFORM_FEE_PERCENTAGE=10.0

# Local development only: accept shared demo passwords (admin@123, etc.) for any account.
# Must be absent or false in production.
ALLOW_DEMO_PASSWORDS=false
